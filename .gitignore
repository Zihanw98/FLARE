# FLARE snapshots written outside an output directory (prefix + 8-digit step).
# Keep input profiles, meshes, conservation histories and other CSV fixtures visible.
/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].csv
/tests/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].csv
/unit_test/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].csv

# Temporary files from local builds/runs. These rules do not remove local data
# or stop tracking files already committed (including archived CCSN results).
*.tmp
/*.pid
/tests/**/*.pid
/unit_test/**/*.pid

# Generated MESA mesh/CFL estimates; retain scripts and input profiles
/profile013_radius_fixed_merged/mesa_amr_estimate/*.csv
/profile013_radius_fixed_merged/mesa_amr_estimate/*.json
/profile013_radius_fixed_merged/mesa_amr_estimate/*.pdf

