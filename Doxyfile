# Run from the FLARE repository root: doxygen Doxyfile
PROJECT_NAME           = FLARE
PROJECT_BRIEF          = "Finite-volume hydrodynamics: framework API reference"
OUTPUT_LANGUAGE        = English
INPUT_ENCODING         = UTF-8
OUTPUT_DIRECTORY       = build/docs
INPUT                  = src docs
FILE_PATTERNS          = *.h *.cpp *.dox
RECURSIVE              = YES
# main.cpp is deliberately outside this documentation pass.
EXCLUDE                = src/main.cpp
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES    = YES
HIDE_UNDOC_MEMBERS      = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_LATEX         = NO
# XML supports repeatable checks of function and parameter documentation.
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = build/docs/doxygen-warnings.log
